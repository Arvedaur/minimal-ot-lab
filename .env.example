# Bu dosyayi .env olarak kopyalayin ve degerleri kendiniz doldurun.
# .env dosyasi asla repo'ya commit edilmemelidir (.gitignore icinde olmali).

# ---- InfluxDB ----
INFLUXDB_INIT_MODE=setup
INFLUXDB_INIT_USERNAME=otlab_admin
INFLUXDB_INIT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_16CHAR_MIN
INFLUXDB_INIT_ORG=otlab
INFLUXDB_INIT_BUCKET=turbine
INFLUXDB_INIT_RETENTION=30d
# Bu token'i ilk kurulumdan sonra InfluxDB UI/CLI'dan alip buraya yazin,
# sonra Telegraf ve Grafana icin AYNI degeri kullanin (least-privilege: mumkunse
# Telegraf icin write-only, Grafana icin read-only iki ayri token olusturun).
INFLUXDB_INIT_ADMIN_TOKEN=CHANGE_ME_GENERATE_RANDOM_64CHAR_TOKEN
INFLUXDB_TELEGRAF_TOKEN=CHANGE_ME_WRITE_ONLY_TOKEN
INFLUXDB_GRAFANA_TOKEN=CHANGE_ME_READ_ONLY_TOKEN

# ---- Grafana ----
GRAFANA_ADMIN_USER=otlab_admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_16CHAR_MIN

# ---- FUXA ----
# FUXA ilk kurulumda kendi admin hesabini UI uzerinden ister; buraya not amacli.
FUXA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_16CHAR_MIN

# ---- Network subnetleri (Aşama 1) ----
PLC_NET_SUBNET=172.20.10.0/24
COLLECTION_NET_SUBNET=172.20.20.0/24
CENTRAL_OT_NET_SUBNET=172.20.30.0/24
